# AI4Math 配置文件
# 复制此文件为 .env 并填入你的 API 密钥

# OpenAI API 密钥（必须）
OPENAI_API_KEY=your-api-key-here

# API 基础 URL（可选，默认使用 DeepSeek Beta 端点以支持 strict 模式）
# OPENAI_BASE_URL=https://api.deepseek.com/beta
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=http://localhost:8000/v1

# 模型名称（可选，默认 deepseek-v4-pro）
# AI4MATH_MODEL=deepseek-v4-pro
# AI4MATH_MODEL=deepseek-v4-flash
# AI4MATH_MODEL=deepseek-chat          # 已弃用，2026/07/24 后下线

# DeepSeek V4 推理模式（可选，默认 high）
# 可选值：none, low, medium, high
# AI4MATH_REASONING_EFFORT=high

# 自动路由模式（可选，默认 true）
# 启用后，先用 flash 模型判断任务难度，简单任务用 flash，复杂任务用 pro
# AI4MATH_AUTO_ROUTE=true

# 自动路由使用的模型（可选）
# AI4MATH_FLASH_MODEL=deepseek-v4-flash
# AI4MATH_PRO_MODEL=deepseek-v4-pro

# Temperature：控制输出随机性（可选，默认 0.0）
# 0.0 = 确定性输出（每次结果一致），1.0 = 更有创造性
# AI4MATH_TEMPERATURE=0.0

# 单次输出最大 token 数（可选，默认 8192）
# AI4MATH_MAX_TOKENS=8192

# 最大工具调用/续写迭代次数（可选，默认 25）
# AI4MATH_MAX_ITERATIONS=25

# 预规划阶段（可选，默认启用）
# 先做规模判断和定理匹配，再进入正式求解
# AI4MATH_PREPLAN_ENABLED=true
# AI4MATH_PREPLAN_MODEL=deepseek-v4-pro
# AI4MATH_PREPLAN_MAX_TOKENS=512

# 定理库来源（可选）
# builtin = 只用内置定理库
# external = 只用外部定理库，加载失败时回退内置库
# merge = 合并内置和外部定理库（默认）
# AI4MATH_THEOREM_SOURCE=merge
# AI4MATH_THEOREM_EXTERNAL_PATH=/absolute/path/to/theorems.json
# AI4MATH_THEOREM_EXTERNAL_URL=https://example.com/theorems.json
# AI4MATH_THEOREM_EXTERNAL_TIMEOUT=5
