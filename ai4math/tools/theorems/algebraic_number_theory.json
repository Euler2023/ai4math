      "domains": [
        "algebraic_number_theory"
      ],
      "keywords": [
        "ideal",
        "factorization",
        "splitting",
        "ramification",
        "inert",
        "理想分解",
        "分裂",
        "惰性",
        "分歧"
      ],
      "signals": [
        "ideal.*factor",
        "split.*inert.*ramif",
        "分裂.*惰性.*分歧"
      ],
      "applicable_when": "计算素数在数域整数环中的分解类型",
      "reduces": "p 的分解由最小多项式 mod p 的因式分解决定",
      "prerequisites": [
        "minimal polynomial",
        "ring of integers basis"
      ],
      "sage_hint": "K.ideal(p).factor()",
      "related": [
        "artin_reciprocity"
      ]
    },
    {
